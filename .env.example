# Copy to .env (`make env` or `cp .env.example .env`). Used by docker compose (web, worker,
# migrate and the Evolution variables below). Hostnames point at Compose services.
# Reference: docs/06-arquitectura.md §6.

# --- General -------------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
TZ=America/Argentina/Buenos_Aires

# --- Infrastructure (injected by Dokku in production; postgres:// is accepted) --------------
DATABASE_URL=postgresql+asyncpg://yavoy:yavoy@postgres:5432/yavoy
REDIS_URL=redis://redis:6379/0

# --- Evolution API ---------------------------------------------------------------------------
EVOLUTION_BASE_URL=http://evolution:8080
# Global API key; also used as Evolution's AUTHENTICATION_API_KEY. Generate one, e.g.
#   python -c "import secrets; print(secrets.token_hex(16))"
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=yavoy
# Path secret of the webhook: http://web:8000/webhooks/evolution/<WEBHOOK_SECRET>
WEBHOOK_SECRET=
# Couriers' group; any other group is ignored.
COURIERS_GROUP_JID=
# Admin phone(s), E.164 without '+', comma-separated.
ADMIN_PHONES=

# --- LLM -------------------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=3

# --- Orders and schedule ---------------------------------------------------------------------
ORDER_CODE_PREFIX=YV-
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=23:00
BUSINESS_DAY_ROLLOVER_TIME=05:00
SCHEDULE_EARLIEST_OPEN_TIME=06:00
SCHEDULE_LATEST_CLOSE_TIME=02:00
SCHEDULE_CONFIRMATION_TTL_MINUTES=5
OUT_OF_HOURS_REPLY_COOLDOWN_MINUTES=30
DRAFT_TTL_MINUTES=30
DRAFT_DEBOUNCE_SECONDS=8
MAX_MISSING_FIELDS_PROMPTS=2
UNCLAIMED_ALERT_MINUTES=20
NOTIFY_LOSER_ON_RACE=true
NOTIFY_REACTION_ON_CANCELLED=true

# --- Reports ---------------------------------------------------------------------------------
REPORT_PENDING_REMINDER_MINUTES=120
DAILY_REPORT_MAX_ATTEMPTS=3

# --- Identity / anti-abuse -------------------------------------------------------------------
STORE_FALLBACK_NAME=Local
COURIER_FALLBACK_NAME=Motero
SENDER_RATE_LIMIT_PER_MINUTE=20
HELP_REPLY_COOLDOWN_MINUTES=30

# --- Worker / scheduler / outbox -------------------------------------------------------------
SCHEDULER_INTERVAL_SECONDS=30
INBOUND_RECOVERY_SECONDS=60
OUTBOUND_MIN_INTERVAL_MS=1000
OUTBOUND_MAX_ATTEMPTS=5
DATA_RETENTION_DAYS=90

# --- Development tooling --------------------------------------------------------------------
# Write every raw webhook payload to CAPTURE_DIR (gitignored). Development only; refused in
# production. See docs/plans/real-number-verification.md.
CAPTURE_INBOUND_PAYLOADS=0
CAPTURE_DIR=data/captures

# --- Evolution container only (read by docker-compose.yml) -----------------------------------
# Public URL of the Evolution manager (QR at http://localhost:8080/manager).
EVOLUTION_SERVER_URL=http://localhost:8080
